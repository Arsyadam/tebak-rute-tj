{
  "name": "tebak-jalur-tj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:data": "node scripts/build-game-data.mjs",
    "build:krl": "node scripts/build-krl-gtfs.mjs",
    "fetch:gtfs": "curl -L --fail --retry 3 -o data/gtfs.zip https://gtfs.transjakarta.co.id/files/file_gtfs.zip && mkdir -p data/gtfs && unzip -o data/gtfs.zip -d data/gtfs",
    "fetch:krl-shapes": "node scripts/fetch-krl-shapes.mjs",
    "fetch:krl-stations": "node scripts/fetch-krl-stations.mjs",
    "refresh:data": "npm run fetch:gtfs && npm run fetch:krl-shapes && npm run build:krl && npm run build:data",
    "refresh:krl": "npm run fetch:krl-stations && npm run fetch:krl-shapes && npm run build:krl && npm run build:data",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "maplibre-gl": "^6.0.0",
    "peerjs": "^1.5.5",
    "radix-ui": "^1.6.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
